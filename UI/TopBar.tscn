[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://UI/TopBar.gd" id="1_topbar"]

[node name="TopBar" type="HBoxContainer"]
script = ExtResource("1_topbar")

[node name="Resources" type="Label" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="OverworldButton" type="Button" parent="."]
layout_mode = 2
text = "Overworld"

[node name="TechTreeButton" type="Button" parent="."]
layout_mode = 2
text = "Tech Tree"

[node name="RefreshButton" type="Button" parent="."]
layout_mode = 2
text = "Refresh Data"

[node name="ConfirmDialog" type="ConfirmationDialog" parent="."]
title = "Refresh Data"
visible = false
dialog_text = "Start a new save? All progress (resources, cleared missions, researched units) will be erased."

[connection signal="pressed" from="OverworldButton" to="." method="_on_overworld_button_pressed"]
[connection signal="pressed" from="TechTreeButton" to="." method="_on_tech_tree_button_pressed"]
[connection signal="pressed" from="RefreshButton" to="." method="_on_refresh_button_pressed"]
[connection signal="confirmed" from="ConfirmDialog" to="." method="_on_refresh_confirmed"]
