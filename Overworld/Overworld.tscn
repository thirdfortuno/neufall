[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Overworld/Overworld.gd" id="1_select"]
[ext_resource type="PackedScene" path="res://UI/TopBar.tscn" id="2_topbar"]
[ext_resource type="Script" path="res://UI/CappedScroll.gd" id="3_scroll"]

[node name="Overworld" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="TopBar" parent="." instance=ExtResource("2_topbar")]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
text = "Missions"
horizontal_alignment = 1

[node name="MissionScroll" type="ScrollContainer" parent="Center/VBox"]
layout_mode = 2
horizontal_scroll_mode = 0
script = ExtResource("3_scroll")
max_height = 200

[node name="MissionList" type="VBoxContainer" parent="Center/VBox/MissionScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="DetailsScroll" type="ScrollContainer" parent="Center/VBox"]
custom_minimum_size = Vector2(400, 130)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Details" type="Label" parent="Center/VBox/DetailsScroll"]
custom_minimum_size = Vector2(380, 0)
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="StartButton" type="Button" parent="Center/VBox"]
layout_mode = 2
disabled = true
text = "Start"

[node name="Errors" type="Label" parent="Center/VBox"]
visible = false
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.4, 0.4, 1)
autowrap_mode = 3

[connection signal="pressed" from="Center/VBox/StartButton" to="." method="_on_start_button_pressed"]
